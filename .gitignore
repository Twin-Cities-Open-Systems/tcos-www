# >>> hee gitignore base >>>
# Managed by: hee check gitignore --fix. Edit the base, not this block.
# Base: .github/gitignore/base.gitignore (the org baseline)
# Never negate one of these back in: in a public repo it publishes
# the file permanently -- see pr:609@human-execution-engine.
secrets/
.hee/secrets/
*.env
*.pem
*.p12
*.pfx
.netrc
id_rsa
id_ecdsa
id_ed25519
# <<< hee gitignore base <<<

__pycache__/
*.pyc

# Security -- never commit secrets. Real gap found live, 2026-08-24:
# hee-cred -seal writes real GPG-encrypted credentials to .hee/secrets/
# (this repo just got a real one, cloudflare-tcos-www.gpg), and this
# repo had zero gitignore coverage for it -- a bare `git add -A` would
# have staged it. Same bare `secrets/` pattern human-execution-engine's
# own .gitignore already uses.
.wrangler/
